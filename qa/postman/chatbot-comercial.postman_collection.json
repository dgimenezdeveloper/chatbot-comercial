{
  "info": {
    "name": "Chatbot Comercial API",
    "description": "Colección de endpoints para el chatbot comercial.\n\n**Variables de entorno requeridas:**\n- `base_url`: http://localhost:8000\n- `token`: JWT obtenido del login\n\n**Flujo típico:**\n1. POST Login → obtiene token\n2. Usar token en endpoints protegidos (Catalog, FAQ, Calendar, Admin)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "1. Health",
      "description": "Health check — sin autenticación",
      "item": [
        {
          "name": "GET Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has status ok', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('ok');",
                  "    pm.expect(json.service).to.eql('chatbot-backend');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Auth",
      "description": "Autenticación — endpoints públicos",
      "item": [
        {
          "name": "POST Login (Mock)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has access_token', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.access_token).to.be.a('string');",
                  "    pm.collectionVariables.set('token', json.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
            }
          }
        },
        {
          "name": "POST Login (Google)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has access_token', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.access_token).to.be.a('string');",
                  "    pm.collectionVariables.set('token', json.access_token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/auth/google",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "google"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"access_token\": \"<google_oauth_access_token>\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Chatbot",
      "description": "Webhook de WhatsApp y chat directo — endpoints públicos",
      "item": [
        {
          "name": "GET Webhook Verify",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200 or 403', () => pm.expect(pm.response.code).to.be.oneOf([200, 403]));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/chatbot/webhook?hub.mode=subscribe&hub.challenge=test123&hub.verify_token=my_verify_token",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "chatbot", "webhook"],
              "query": [
                {
                  "key": "hub.mode",
                  "value": "subscribe",
                  "description": "Debe ser 'subscribe' para verificación"
                },
                {
                  "key": "hub.challenge",
                  "value": "test123",
                  "description": "Challenge string que se devuelve"
                },
                {
                  "key": "hub.verify_token",
                  "value": "my_verify_token",
                  "description": "Debe coincidir con WHATSAPP_VERIFY_TOKEN"
                }
              ]
            }
          }
        },
        {
          "name": "POST Webhook Receive",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response is success', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('success');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/chatbot/webhook",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "chatbot", "webhook"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"object\": \"whatsapp_business_account\",\n  \"entry\": [\n    {\n      \"id\": \"WHATSAPP_BUSINESS_ACCOUNT_ID\",\n      \"changes\": [\n        {\n          \"value\": {\n            \"messaging_product\": \"whatsapp\",\n            \"metadata\": {\n              \"display_phone_number\": \"5491112345678\",\n              \"phone_number_id\": \"123456789\"\n            },\n            \"contacts\": [\n              {\n                \"profile\": {\n                  \"name\": \"Cliente Demo\"\n                },\n                \"wa_id\": \"5491123456789\"\n              }\n            ],\n            \"messages\": [\n              {\n                \"from\": \"5491123456789\",\n                \"id\": \"wamid.test123\",\n                \"timestamp\": \"1710000000\",\n                \"text\": {\n                  \"body\": \"Hola, quiero un turno\"\n                },\n                \"type\": \"text\"\n              }\n            ]\n          },\n          \"field\": \"messages\"\n        }\n      ]\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "POST Chat Directo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has respuesta and tipo', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.respuesta).to.be.a('string');",
                  "    pm.expect(json.tipo).to.be.a('string');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/chatbot/chat",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "chatbot", "chat"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"telefono\": \"5491123456789\",\n  \"mensaje\": \"Hola\"\n}"
            }
          }
        }
      ]
    },
